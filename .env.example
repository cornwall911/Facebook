# ==========================================
# Facebook Viral Scout - Environment Config
# ==========================================

# 1. إعدادات بوت التليجرام (Telegram Notifications)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=123456789

# 2. رابط موقع الداش بورد على Cloudflare Pages (اختياري لوضعه في رسالة التليجرام)
CLOUDFLARE_PAGES_URL=https://fb-winner-scout.pages.dev

# 3. إعدادات السكوت
MIN_REACTIONS=100
HEADLESS=true

# 4. مفتاح Google Gemini API لتوليد كابشن البوستات الذكي (اختياري)
# يمكنك الحصول عليه مجاناً من https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
